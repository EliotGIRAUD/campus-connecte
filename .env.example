# Comptes pédagogiques du kit MQTT — pas des secrets de production.
MQTT_PORT=1883
SIMULATOR_PASSWORD=simulator-demo
BACKEND_PASSWORD=backend-demo
TEACHER_PASSWORD=teacher-demo
PUBLISH_INTERVAL=2

# Backend
PORT=3000
DATABASE_URL=postgresql://campus:campus@localhost:5432/campus
LAKE_MONGO_URL=mongodb://localhost:27017
LAKE_MONGO_DB=campus_lake
MQTT_URL=mqtt://localhost:1883
MQTT_USER=backend
MQTT_PASSWORD=backend-demo
# Identifiant MQTT stable (obligatoire pour session persistante clean:false)
MQTT_CLIENT_ID=campus-backend

# Paramètres métier documentés (docs/architecture.md)
FRESHNESS_MS=10000
COMMAND_TIMEOUT_MS=15000
ALERT_CO2_PPM=1500
ALERT_HYSTERESIS_PPM=200
HISTORY_LIMIT=200
AVERAGE_WINDOW_MS=600000
AVERAGE_RETENTION_MS=2592000000
LAKE_TTL_SECONDS=604800
CONSOLIDATION_WORKERS=2
CONSOLIDATION_POLL_MS=200
CONSOLIDATION_LOCK_MS=30000
CONSOLIDATION_MAX_ATTEMPTS=8
CONSOLIDATION_LAG_WARN_MS=10000
LOG_LEVEL=info

# Observabilité (Grafana http://localhost:3001 — valeurs pédagogiques uniquement)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=campus-demo

# Mobile (émulateur Android : http://10.0.2.2:3000 — téléphone : http://IP_DU_PC:3000)
EXPO_PUBLIC_API_URL=http://localhost:3000
