generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client-lake"
}

datasource db {
  provider = "postgresql"
  url      = env("LAKE_DATABASE_URL")
}

/// Append-only raw MQTT stream — data lake (everything received, before business rules).
model RawMqttEvent {
  id          String   @id @default(cuid())
  topic       String
  deviceId    String?
  messageKind String?
  payloadRaw  String
  payloadJson Json?
  receivedAt  DateTime @default(now())
  outcome     String   @default("received")

  @@index([receivedAt(sort: Desc)])
  @@index([deviceId, receivedAt(sort: Desc)])
  @@index([outcome])
}
